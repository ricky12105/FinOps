# ==============================================================================
# Zava FinOps & Platform Observability — Environment Configuration Template
# Copy this file to `.env` (git-ignored) or customize `config/customer.local.json`
# ==============================================================================

# 1. Azure Tenant & Subscription Scope
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000001
AZURE_TENANT_DOMAIN=contoso.onmicrosoft.com
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000002

# 2. Microsoft Fabric Target Workspace & Lakehouse
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000003
FABRIC_WORKSPACE_NAME=FinOps
FABRIC_CAPACITY_ID=00000000-0000-0000-0000-000000000004
FABRIC_CAPACITY_SKU=F4
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000005
FABRIC_LAKEHOUSE_NAME=ZavaFinOpsFoundation
FABRIC_SQL_ENDPOINT_ID=00000000-0000-0000-0000-000000000006

# 3. Fabric Serving Notebook, Direct Lake Model, Report & Data Agent
FABRIC_SERVING_NOTEBOOK_ID=00000000-0000-0000-0000-000000000007
FABRIC_SEMANTIC_MODEL_ID=00000000-0000-0000-0000-000000000008
FABRIC_SEMANTIC_MODEL_NAME=ZavaFinOpsDemo
FABRIC_REPORT_ID=00000000-0000-0000-0000-000000000009
FABRIC_REPORT_NAME=Zava FinOps Operating Demo
FABRIC_DATA_AGENT_ID=00000000-0000-0000-0000-000000000010
FABRIC_DATA_AGENT_NAME=ZavaFinOps_Agent

# 4. Supporting SQL Endpoints (FUAM Lakehouse & Business Context SQL Database)
FUAM_SQL_SERVER=your-fuam-endpoint.datawarehouse.fabric.microsoft.com
FUAM_SQL_DATABASE=FUAM_Lakehouse
BUSINESS_CONTEXT_SQL_SERVER=your-sql-endpoint.database.fabric.microsoft.com
BUSINESS_CONTEXT_SQL_DATABASE=ZavaFinOpsBusinessContext

# 5. Azure Databricks System Tables Extraction (Optional for Live Mode)
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_WORKSPACE_ID=0000000000000000
DATABRICKS_WAREHOUSE_ID=0000000000000000
DATABRICKS_PROFILE=DEFAULT

# 6. Governed Action — Power Automate & Least-Privilege Tag Operator (Optional)
POWER_AUTOMATE_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000011
POWER_AUTOMATE_FLOW_ID=00000000-0000-0000-0000-000000000012
POWER_AUTOMATE_LOCATION=unitedstates
POWER_AUTOMATE_REGION=westus
APPROVED_TAG_RESOURCE_GROUP=RG-fabric
APPROVED_TAG_RESOURCE_NAME=zavafabriccapacity
TAG_OPERATOR_UPN=finops-tag-operator@contoso.onmicrosoft.com
TAG_OPERATOR_OBJECT_ID=00000000-0000-0000-0000-000000000013
DEMO_ADMIN_UPN=finops-admin@contoso.onmicrosoft.com
DEMO_ADMIN_OBJECT_ID=00000000-0000-0000-0000-000000000014
