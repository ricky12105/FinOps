		lineageTag: 13470e85-dfab-44c6-86f6-ee4003a33b71
		sourceColumn: Operation

	column 'Reported CU Value'
		dataType: decimal
		isHidden
		lineageTag: 6ed946d0-b323-4fb9-9d83-5a66bd463421
		sourceColumn: ReportedCUValue

	column 'Operation Count'
