/// Unique FUAM day/capacity/workspace/item/kind/operation source grain, Aug 17-28 2026. Reported CU source measure is not billed USD or CPU utilization.
table 'Fabric Operations'
	lineageTag: becc8db7-8d20-4d7b-bd18-06551a75f04e

	/// FUAM TotalCUs source measure, displayed to four decimals. Do not interpret as dollars, CPU-percent or licensed capacity size.
	measure 'Observed CUs' = SUM('Fabric Operations'[Reported CU Value])
		formatString: #,##0.00
		lineageTag: ba53bf29-d10f-48c4-941c-644aa79104b1

	/// Source operation counts in the bounded Aug 17-28 slice; not summed user counts.
	measure 'Fabric Operation Count' = SUM('Fabric Operations'[Operation Count])
		formatString: #,##0
		lineageTag: 1b40f019-f7b3-4261-bc1d-88973d21aff1

	/// Source failure count; no allocation to billed cost.
	measure 'Failed Fabric Operations' = SUM('Fabric Operations'[Failed Count])
		formatString: #,##0
		lineageTag: 730def0f-8cbf-4801-b632-3c9bb5f2a3a0

	/// Reported operation-grain throttling minutes; may overlap in time and are not unique wall-clock downtime.
	measure 'Throttling Minutes' = SUM('Fabric Operations'[Throttling Minutes Value])
		formatString: #,##0.00
		lineageTag: bb0e9e76-9937-4d72-a057-ffa4bbcf37de

	column Date
		dataType: dateTime
		lineageTag: 8528a7cf-88e2-48f0-8842-7221e76a2b19
		sourceColumn: Date

	column 'Entity Key'
