/// Three modeled months Oct-Dec 2026 using last three closed months. Illustrative error range; not calibrated confidence, budget or savings.
table Forecast
	lineageTag: c9e635d2-bf75-4dee-a9de-ad02ec9864a7

	/// Trailing-three-month modeled baseline for October-December 2026; not actuals or budget.
	measure 'Forecast USD' = SUM('Forecast'[Baseline Value])
		formatString: $#,##0.00
		lineageTag: b707e398-9923-4a9a-9f0c-2fcdd172d585

	/// Illustrative baseline or +/-10% sensitivity; no approved savings or realized business case.
	measure 'Scenario USD' = [Forecast USD]*SELECTEDVALUE('Scenario'[Factor],1)
		formatString: $#,##0.00
		lineageTag: 4c6e811a-1d61-4235-8bb1-34615341fcb2

	/// Baseline minus twice three-period retrospective MAE, floored at zero. Not a calibrated confidence interval.
	measure 'Lower Illustrative USD' = SUM('Forecast'[Lower Value])
		formatString: $#,##0.00
		lineageTag: 398d3f01-65c1-485e-89e0-6294b99e32b6

	/// Baseline plus twice three-period retrospective MAE. Not a calibrated confidence interval.
	measure 'Upper Illustrative USD' = SUM('Forecast'[Upper Value])
		formatString: $#,##0.00
		lineageTag: 1fc8ec36-9c33-466e-b3d0-716a098728cc

	/// Illustrative sensitivity difference from baseline, not realized savings or approved budget.
	measure 'Scenario Change USD' = [Scenario USD]-[Forecast USD]
		formatString: $#,##0.00;($#,##0.00)
		lineageTag: 988474eb-28c1-4fd7-97f8-6221585ac66e

	column Date
