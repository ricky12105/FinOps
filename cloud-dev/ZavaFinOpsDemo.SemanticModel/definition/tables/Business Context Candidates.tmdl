/// Read-only controlled internal-assignment inputs; same existing UDF and server-side authorization, no new assignment tests.
table 'Business Context Candidates'
	lineageTag: 04ef6bef-4a53-47bb-a011-7f856bb01ea5

	/// Existing UDF single-resource input; backend authorization is authoritative.
	measure 'Selected Resource Key' = IF(HASONEVALUE('Business Context Candidates'[Resource Key]),SELECTEDVALUE('Business Context Candidates'[Resource Key]))
		formatString: @
		lineageTag: 8e03c90f-f421-469e-bdce-77d8e9c7d696

